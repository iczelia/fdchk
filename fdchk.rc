#include <windows.h>

/*  Application icon (resource id 1).  */
1 ICON "fdchk.ico"

/*  The FDC VxD, embedded as a raw blob.  */
FDCHKVXD RCDATA "fdchk.vxd"

/*  Version stamp.  */
1 VERSIONINFO
 FILEVERSION    1, 0, 0, 0
 PRODUCTVERSION 1, 0, 0, 0
 FILEOS   0x40004L        /*  VOS_NT_WINDOWS32 - also valid on 9x  */
 FILETYPE 0x1L            /*  VFT_APP  */
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904E4"
    BEGIN
      VALUE "CompanyName",      "iczelia\0"
      VALUE "FileDescription",  "Floppy Disk Checker\0"
      VALUE "FileVersion",      "1.0.2\0"
      VALUE "InternalName",     "fdchk\0"
      VALUE "OriginalFilename", "fdchk.exe\0"
      VALUE "ProductName",      "Floppy Disk Checker\0"
      VALUE "ProductVersion",   "1.0.2\0"
    END
  END
  BLOCK "VarFileInfo" BEGIN VALUE "Translation", 0x0409, 1252 END
END
